# =================================================================
# Shlink Natura — Production Environment
# Copy this file to .env and fill in all required values before
# running: docker compose -f docker-compose.prod.yml up -d --build
# =================================================================

# -----------------------------------------------------------------
# App (REQUIRED)
# -----------------------------------------------------------------

# Domain used for short URLs — no protocol, no trailing slash
# Local VM:     192.168.1.50:8080
# With domain:  s.yourdomain.com
DEFAULT_DOMAIN=s.yourdomain.com

# Set to true if Shlink is behind HTTPS (reverse proxy handles TLS)
IS_HTTPS_ENABLED=false

# Host port Shlink listens on
SHLINK_PORT=8080

# Your timezone (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=America/New_York

# -----------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------

DB_NAME=shlink
DB_USER=shlink
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password

# -----------------------------------------------------------------
# Initial API Key
# -----------------------------------------------------------------

# Set a value on first boot — Shlink will create this API key and
# print it. Clear or leave blank after the first successful start
# to avoid re-generating on every restart.
INITIAL_API_KEY=

# -----------------------------------------------------------------
# GeoLite2 IP Geolocation (optional)
# -----------------------------------------------------------------

# Free license at: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# Leave blank to skip geolocation entirely.
GEOLITE_LICENSE_KEY=

# Set to false once you have a GEOLITE_LICENSE_KEY
SKIP_INITIAL_GEOLITE_DOWNLOAD=true

# -----------------------------------------------------------------
# Workers (tune to your VM's CPU count — run `nproc` on the VM)
# -----------------------------------------------------------------

WEB_WORKER_NUM=4
TASK_WORKER_NUM=2

# -----------------------------------------------------------------
# Memory
# -----------------------------------------------------------------

MEMORY_LIMIT=512M

# -----------------------------------------------------------------
# Shlink web client (admin/stats UI on http://<VM-IP>:8081)
# -----------------------------------------------------------------

WEB_CLIENT_PORT=8081

# API key the web client and the Odoo sync use. Generate after first
# boot with: make api-key   (or set INITIAL_API_KEY above on first boot)
SHLINK_API_KEY=

# -----------------------------------------------------------------
# Odoo -> Shlink equipment sync
# -----------------------------------------------------------------

ODOO_URL=https://os.natura.io
# Database name (visible in Odoo's login/database selector, or ask your admin)
ODOO_DB=
# Login of the Odoo user the sync reads as
ODOO_USER=kenny.g@natura.io
# API key for that user: Odoo -> My Profile -> Account Security -> New API Key
ODOO_API_KEY=

# Where each equipment short URL redirects. {id} is replaced per record.
LONG_URL_TEMPLATE=https://os.natura.io/web#id={id}&cids=6&menu_id=519&action=743&model=maintenance.equipment&view_type=form

# Short URL slug prefix -> http://<DEFAULT_DOMAIN>/eq-<id>
SLUG_PREFIX=eq-

# How often to look for new equipment (seconds)
SYNC_INTERVAL_SECONDS=900
